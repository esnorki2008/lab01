# Copiar a .env (opcional).
# En Linux use su UID para que los archivos creados por Airflow le pertenezcan:  echo "AIRFLOW_UID=$(id -u)" > .env
AIRFLOW_UID=50000
# Directorio del remoto DVC local montado en el contenedor (debe coincidir con .dvc/config)
DVC_REMOTE_DIR=../dvc-storage
AIRFLOW_JWT_SECRET=favorita-lab-jwt-secret-change-me
